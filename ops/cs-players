# Print the human player count of a Source/GoldSrc server via A2S_INFO.
#   cs-players [host] [port]   -> "humans=N players=P bots=B map=NAME" (exit 0)
# Exit 2 when the server does not answer or the reply cannot be read, so callers
# must treat 2 as "unknown, do not reboot/restart".
# CS_PLAYERS_TIMEOUT sets the reply timeout in seconds (default 5).
import os
import socket
import sys

host = sys.argv[1] if len(sys.argv) > 1 else "127.0.0.1"
port = int(sys.argv[2]) if len(sys.argv) > 2 else 27015
timeout = float(os.environ.get("CS_PLAYERS_TIMEOUT", "5"))
Q = b"\xff\xff\xff\xffTSource Engine Query\x00"


def cstr(buf, i):
    j = buf.index(b"\x00", i)
    return buf[i:j].decode("utf-8", "replace"), j + 1


def ask():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(timeout)
    try:
        sock.sendto(Q, (host, port))
        data, _ = sock.recvfrom(4096)
        if data[4:5] == b"A":  # challenge: repeat the query with the 4 bytes appended
            sock.sendto(Q + data[5:9], (host, port))
            data, _ = sock.recvfrom(4096)
        return data
    finally:
        sock.close()


try:
    reply = ask()
    if reply[:4] != b"\xff\xff\xff\xff":
        raise ValueError("bad header")
    kind = reply[4:5]
    if kind == b"I":  # Source format
        idx = 6
        _name, idx = cstr(reply, idx)
        mapname, idx = cstr(reply, idx)
        for _ in range(2):  # folder, game
            _, idx = cstr(reply, idx)
        idx += 2  # app id
        players, _max, bots = reply[idx], reply[idx + 1], reply[idx + 2]
    elif kind == b"m":  # GoldSrc legacy format
        idx = 5
        _addr, idx = cstr(reply, idx)
        _name, idx = cstr(reply, idx)
        mapname, idx = cstr(reply, idx)
        for _ in range(2):  # folder, game
            _, idx = cstr(reply, idx)
        players, _max = reply[idx], reply[idx + 1]
        idx += 2 + 1 + 1 + 1 + 1 + 1  # protocol, type, os, password, mod
        mod = reply[idx - 1]
        if mod:
            for _ in range(2):
                _, idx = cstr(reply, idx)
            idx += 4 + 4 + 1 + 1  # version, size, type, dll
        bots = reply[idx + 1] if idx + 1 < len(reply) else 0
    else:
        raise ValueError("unknown reply type %r" % kind)
    print(
        "humans=%d players=%d bots=%d map=%s"
        % (max(players - bots, 0), players, bots, mapname or "?")
    )
except Exception as exc:
    print("unknown (%s)" % exc, file=sys.stderr)
    sys.exit(2)
