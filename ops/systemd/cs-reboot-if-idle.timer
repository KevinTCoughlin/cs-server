#
# 04:05 America/Los_Angeles, then every 20 minutes through 07:45. The service
# reboots only when /var/run/reboot-required exists, no human is on a checked
# game port, and nobody is logged in over SSH. Persistent=false: a VPS that
# was off during the window does not reboot when it comes back.

[Unit]
Description=Check for an idle-time reboot (04:05 to 07:45 Pacific, every 20 minutes)

[Timer]
OnCalendar=*-*-* 04..07:05/20:00 America/Los_Angeles
RandomizedDelaySec=60
Persistent=false

[Install]
WantedBy=timers.target
