#
# Daily archive of the cs-server-state volume. Installed by install.sh when
# CS_BACKUP=1 (ops/bootstrap-vps.sh turns that on). The script is copied to
# ~/.local/bin/cs-server-backup.

[Unit]
Description=Back up the CS 1.6 server state volume
Documentation=https://github.com/KevinTCoughlin/cs-server#deploy-on-a-fresh-vps

[Service]
Type=oneshot
ExecStart=%h/.local/bin/cs-server-backup
Nice=10
