# CS 1.6 ScoutzKnivez Server — Container environment variables
# Copy to .env and edit: cp .env.example .env

# Starting map
MAP=scoutzknivez

# Max player slots
MAXPLAYERS=20

# Server port
PORT=27015

# Enable ZBots (1=on, 0=off)
BOTS=1

# Map rotation file
MAPCYCLE=mapcycle.txt

# Public server mode (0=public, 1=LAN-only)
LAN_MODE=0

# Disable master-server registration (1=on, 0=off)
NOMASTER=0
