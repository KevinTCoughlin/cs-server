# CS 1.6 ScoutzKnivez Server — Container environment variables
# Copy to .env and edit: cp .env.example .env

# Starting map
MAP=scoutzknivez

# Max player slots
MAXPLAYERS=20

# Server port
PORT=27015

# Enable ZBots (1=on, 0=off)
BOTS=1

# Map rotation file
MAPCYCLE=mapcycle.txt

# Public server mode (0=public, 1=LAN-only)
LAN_MODE=0

# Disable master-server registration (1=on, 0=off)
NOMASTER=0

# Startup game mode (scoutz, knife, vanilla, match, climb, surf or auto).
# auto picks climb or surf from the map name. movement is the same as auto.
MODE=scoutz

# FastDL: http(s) URL that serves your cstrike/ content (sets sv_downloadurl).
# Empty: clients download custom content from the game server itself.
FASTDL_URL=

# Server log files in the state volume (1=on, 0=off)
LOGS=1

# Delete log files older than this many days (0 keeps them all)
LOG_RETENTION_DAYS=30

# host:port of a log receiver such as HLstatsX (needs LOGS=1). Empty: none.
LOGADDRESS=

# IPv4 address to bind and report to Steam (+ip). Empty: the engine picks the
# address its hostname resolves to. Set it on a host-networked public server
# whose log says "Could not establish connection to Steam servers".
SERVER_IP=

# Prometheus metrics endpoint inside the container (empty: off). Publish the
# port yourself, e.g. ports: ["127.0.0.1:9137:9137/tcp"]
METRICS_PORT=
