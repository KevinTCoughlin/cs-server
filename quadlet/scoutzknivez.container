[Unit]
Description=CS 1.6 ScoutzKnivez Server
After=network-online.target

[Container]
Image=localhost/cs-server:latest
ContainerName=scoutzknivez
PublishPort=27015:27015/udp
PublishPort=27015:27015/tcp
Volume=%h/Development/cs-server/config/server.cfg:/hlds/cstrike/server.cfg:ro,Z
Volume=%h/Development/cs-server/config/mapcycle.txt:/hlds/cstrike/mapcycle.txt:ro,Z
Environment=MAP=scoutzknivez
Environment=MAXPLAYERS=20
Environment=PORT=27015
Environment=BOTS=1
DropCapability=ALL
NoNewPrivileges=true
StopTimeout=50
Notify=healthy

[Service]
Restart=on-failure
RestartSec=10
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=default.target
