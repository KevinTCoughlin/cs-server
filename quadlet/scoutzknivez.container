[Unit]
Description=CS 1.6 ScoutzKnivez Server
After=network-online.target

[Container]
Image=localhost/cs-server:latest
ContainerName=scoutzknivez
PublishPort=27015:27015/udp
PublishPort=27015:27015/tcp
Volume=%h/.config/cs-server/server.cfg:/hlds/cstrike/server.cfg:ro,Z
Volume=%h/.config/cs-server/mapcycle.txt:/hlds/cstrike/mapcycle.txt:ro,Z
Volume=%h/.config/cs-server/mapcycle-dust2.txt:/hlds/cstrike/mapcycle-dust2.txt:ro,Z
Volume=%h/.config/cs-server/mapcycle-nipper.txt:/hlds/cstrike/mapcycle-nipper.txt:ro,Z
Environment=MAP=scoutzknivez
Environment=MAXPLAYERS=20
Environment=PORT=27015
Environment=BOTS=1
Environment=MAPCYCLE=mapcycle.txt
Environment=LAN_MODE=0
Sysctl=net.core.rmem_max=26214400
Sysctl=net.core.wmem_max=26214400
DropCapability=ALL
NoNewPrivileges=true
Notify=healthy

[Service]
Restart=on-failure
RestartSec=10
TimeoutStopSec=50
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=default.target
