[Unit]
Description=CS 1.6 ScoutzKnivez Server
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/cs-server:latest
ContainerName=scoutzknivez
PublishPort=27015:27015/udp
Volume=%h/.config/cs-server/server.cfg:/hlds/cstrike/server.cfg:ro,Z
Volume=%h/.config/cs-server/mapcycle.txt:/hlds/cstrike/mapcycle.txt:ro,Z
Volume=%h/.config/cs-server/mapcycle-dust2.txt:/hlds/cstrike/mapcycle-dust2.txt:ro,Z
Volume=%h/.config/cs-server/mapcycle-nipper.txt:/hlds/cstrike/mapcycle-nipper.txt:ro,Z
Volume=%h/.config/cs-server/mapcycle-nipper-xmas.txt:/hlds/cstrike/mapcycle-nipper-xmas.txt:ro,Z
Volume=%h/.config/cs-server/modes:/hlds/cstrike/modes:ro,Z
Volume=cs-server-state:/hlds/state
Environment=MAP=scoutzknivez
Environment=MAXPLAYERS=20
Environment=PORT=27015
Environment=BOTS=1
Environment=MAPCYCLE=mapcycle.txt
Environment=LAN_MODE=0
Environment=MODE=scoutz
Environment=LOGS=1
Environment=LOG_RETENTION_DAYS=7
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=/healthcheck.sh
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180
RestartSec=10
TimeoutStopSec=50
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=default.target
