# FastDL sidecar for the movement server. Image= must be the same string as
# in quadlet/cs-server-movement.container, including a digest pin.
# cs-server-update rewrites both together from
# ghcr.io/kevintcoughlin/cs-server-movement (:main, then :sha-<7>@sha256:…).
# ~/cs-maps is mounted at /maps-local only. fastdl.sh adds a host file to the
# serve tree when maps/manifest.tsv says fastdl=yes. fastdl=no maps, including
# kz_man_everest, bkz_goldbhop, bkz_toonworld and kz_climbers_b01, are not
# published. Do not add per-file mounts of those .bsp files here: the serve
# tree follows /hlds/cstrike/maps, so a file mount would publish them.
# GitHub Pages (just fastdl) uses the same allowlist.
[Unit]
Description=CS 1.6 movement FastDL (maps over HTTP)
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/kevintcoughlin/cs-server-movement:main
ContainerName=cs-fastdl-movement
PodmanArgs=--entrypoint /fastdl.sh
PublishPort=27080:27080/tcp
Environment=FASTDL_PORT=27080
# maps-local: begin
Volume=%h/cs-maps:/maps-local:ro,Z
Environment=MAPS_LOCAL=/maps-local
# maps-local: end
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=/fastdl.sh check
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=10
MemoryMax=64M
CPUQuota=50%

[Install]
WantedBy=default.target
