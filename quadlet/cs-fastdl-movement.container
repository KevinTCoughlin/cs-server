# FastDL sidecar for the movement server. Image= must be the same string as
# in quadlet/cs-server-movement.container, including a digest pin. Repoint
# both together. This container serves every map, sound, sprite, model, gfx,
# overview and wad in that image, including maps whose manifest row says
# fastdl=no. That matches sv_allowdownload: the client can fetch whatever the
# server has. GitHub Pages (just fastdl) is the tree that skips fastdl=no.
[Unit]
Description=CS 1.6 movement FastDL (maps over HTTP)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/cs-server:movement
ContainerName=cs-fastdl-movement
PodmanArgs=--entrypoint /fastdl.sh
PublishPort=27080:27080/tcp
Environment=FASTDL_PORT=27080
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=/fastdl.sh check
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=10
MemoryMax=64M
CPUQuota=50%

[Install]
WantedBy=default.target
