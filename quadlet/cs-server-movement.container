# Movement server: surf or climb from the map name (MODE=auto,
# mapcycle-movement.txt). Image= is the movement image CI publishes
# (ghcr.io/kevintcoughlin/cs-server-movement:main and :sha-<7>). It must be
# the same string as in quadlet/cs-fastdl-movement.container, including a
# digest pin. cs-server-update rewrites both together. The published image
# does not contain the rotation. ~/cs-maps (this unit: %h/cs-maps) is mounted
# read-only at /maps-local, and each .bsp is mounted on its own path so the
# stock maps stay visible. The sidecar does not get those file mounts.
# Replace HOST in FASTDL_URL with the address clients use (CS_FASTDL_HOST).
# Do not set sv_downloadurl in server.cfg; the entrypoint maps FASTDL_URL to
# +sv_downloadurl, which survives the per-map re-exec of server.cfg.
[Unit]
Description=CS 1.6 movement server
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/kevintcoughlin/cs-server-movement:main
ContainerName=cs-server-movement
PublishPort=27016:27016/udp
Volume=%h/.config/cs-server-movement/server.cfg:/hlds/cstrike/server.cfg:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle.txt:/hlds/cstrike/mapcycle.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-dust2.txt:/hlds/cstrike/mapcycle-dust2.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-nipper.txt:/hlds/cstrike/mapcycle-nipper.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-nipper-xmas.txt:/hlds/cstrike/mapcycle-nipper-xmas.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-climb.txt:/hlds/cstrike/mapcycle-climb.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-surf.txt:/hlds/cstrike/mapcycle-surf.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-movement.txt:/hlds/cstrike/mapcycle-movement.txt:ro,Z
Volume=%h/.config/cs-server-movement/modes:/hlds/cstrike/modes:ro,Z
# maps-local: begin
Volume=%h/cs-maps:/maps-local:ro,Z
Volume=%h/cs-maps/maps/kz_man_everest.bsp:/hlds/cstrike/maps/kz_man_everest.bsp:ro,Z
Volume=%h/cs-maps/maps/bkz_goldbhop.bsp:/hlds/cstrike/maps/bkz_goldbhop.bsp:ro,Z
Volume=%h/cs-maps/maps/bkz_toonworld.bsp:/hlds/cstrike/maps/bkz_toonworld.bsp:ro,Z
Volume=%h/cs-maps/maps/kz_climbers_b01.bsp:/hlds/cstrike/maps/kz_climbers_b01.bsp:ro,Z
Volume=%h/cs-maps/maps/surf_ski_5.bsp:/hlds/cstrike/maps/surf_ski_5.bsp:ro,Z
Volume=%h/cs-maps/maps/surf_nice_fly_4.bsp:/hlds/cstrike/maps/surf_nice_fly_4.bsp:ro,Z
Volume=%h/cs-maps/maps/surf_srventer.bsp:/hlds/cstrike/maps/surf_srventer.bsp:ro,Z
Volume=%h/cs-maps/maps/surf_nice_fly.bsp:/hlds/cstrike/maps/surf_nice_fly.bsp:ro,Z
Volume=%h/cs-maps/maps/surf_colorama_beta.bsp:/hlds/cstrike/maps/surf_colorama_beta.bsp:ro,Z
Environment=MAPS_LOCAL=/maps-local
# maps-local: end
Volume=cs-server-state-movement:/hlds/state
Environment=MAXPLAYERS=20
Environment=PORT=27016
Environment=BOTS=0
Environment=MAPCYCLE=mapcycle-movement.txt
Environment=LAN_MODE=0
Environment=MODE=auto
Environment=LOGS=1
Environment=LOG_RETENTION_DAYS=30
Environment=FASTDL_URL=http://HOST:27080/cstrike/
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
# Under memory pressure the kernel kills the game before sshd and system services.
PodmanArgs=--oom-score-adj=500
HealthCmd=/healthcheck.sh
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180
RestartSec=10
TimeoutStopSec=50
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=default.target
