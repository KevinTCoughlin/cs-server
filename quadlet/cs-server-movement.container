# Movement / climb server. Image= must be the same string as in
# quadlet/cs-fastdl-movement.container, including a digest pin. Repoint both
# together: the sidecar serves the maps baked into its image, and a different
# image than the game server is running hands clients the wrong files.
# The box currently runs localhost/cs-server:movement-cfd95fa. This template
# uses the stable name localhost/cs-server:movement. Retag that image, or
# change both Image= lines to the sha tag, before copying these units over.
# Replace HOST in FASTDL_URL with the address clients use (CS_FASTDL_HOST).
# Do not set sv_downloadurl in server.cfg; the entrypoint maps FASTDL_URL to
# +sv_downloadurl, which survives the per-map re-exec of server.cfg.
[Unit]
Description=CS 1.6 movement server
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/cs-server:movement
ContainerName=cs-server-movement
PublishPort=27016:27016/udp
Volume=%h/.config/cs-server-movement/server.cfg:/hlds/cstrike/server.cfg:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle.txt:/hlds/cstrike/mapcycle.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-dust2.txt:/hlds/cstrike/mapcycle-dust2.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-nipper.txt:/hlds/cstrike/mapcycle-nipper.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-nipper-xmas.txt:/hlds/cstrike/mapcycle-nipper-xmas.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-climb.txt:/hlds/cstrike/mapcycle-climb.txt:ro,Z
Volume=%h/.config/cs-server-movement/mapcycle-surf.txt:/hlds/cstrike/mapcycle-surf.txt:ro,Z
Volume=%h/.config/cs-server-movement/modes:/hlds/cstrike/modes:ro,Z
Volume=cs-server-state-movement:/hlds/state
Environment=MAXPLAYERS=20
Environment=PORT=27016
Environment=BOTS=0
Environment=MAPCYCLE=mapcycle-climb.txt
Environment=LAN_MODE=0
Environment=MODE=climb
Environment=LOGS=1
Environment=LOG_RETENTION_DAYS=30
Environment=FASTDL_URL=http://HOST:27080/cstrike/
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
# Under memory pressure the kernel kills the game before sshd and system services.
PodmanArgs=--oom-score-adj=500
HealthCmd=/healthcheck.sh
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180
RestartSec=10
TimeoutStopSec=50
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=default.target
